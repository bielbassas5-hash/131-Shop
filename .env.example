PORT=3001
SESSION_SECRET=cambia-esto-por-algo-secreto
ADMIN_PASSWORD=cambia-esta-contrasena

# OPCIONAL: si rellenas esto, el checkout usara Stripe (pago con tarjeta, con comision).
# Consigue tus claves en https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Si dejas STRIPE_SECRET_KEY vacio, se usa pago manual (transferencia bancaria / Bizum,
# sin comisiones). Rellena estos datos para que se muestren al cliente en la pagina de pago.
BANK_IBAN=ES00 0000 0000 0000 0000 0000
BIZUM_PHONE=600000000

# Precio de envio por defecto en centimos (ej. 350 = 3,50 EUR)
SHIPPING_COST_CENTS=350

# OPCIONAL, solo para produccion (hosting gratuito sin disco persistente):
# base de datos en Turso (turso.tech, gratis) en vez del archivo local.
# Si se dejan vacios, se usa un archivo SQLite local en data/store.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# OPCIONAL, solo para produccion: almacenar las imagenes subidas en Cloudinary
# (cloudinary.com, gratis) en vez del disco local. Si se dejan vacios, las
# imagenes se guardan en public/uploads (solo sirve en local, no en hosting
# sin disco persistente).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Ajustes de tienda (todos opcionales) ----
# Envio gratis a partir de este importe en centimos (0 = desactivado). Ej: 3000 = 30 EUR
FREE_SHIPPING_THRESHOLD_CENTS=0
# Paises a los que envias, separados por comas (ES,PT,FR,DE,IT,AD,NL,BE)
SHIPPING_COUNTRIES=ES
# Dias que se reserva el stock de un pedido sin pagar antes de cancelarlo solo
PENDING_EXPIRY_DAYS=5

# Datos que se muestran en el pie y en las paginas legales (rellenalos antes de vender)
CONTACT_EMAIL=
INSTAGRAM=
LEGAL_NAME=
LEGAL_NIF=
LEGAL_ADDRESS=
# URL publica de la tienda (para sitemap, enlaces en emails y SEO)
SITE_URL=

# ---- Recogida en mano (opcional) ----
PICKUP_ENABLED=0
# Texto que ve el cliente junto a la opcion (ej: "Zona Barcelona, a convenir")
PICKUP_NOTE=

# ---- Avisos por email (opcional, gratis hasta 300/dia con Brevo: brevo.com) ----
# Usa la API HTTP porque Render gratis bloquea el SMTP.
# MAIL_FROM debe ser un remitente verificado en Brevo.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=131
# Recibes un email por cada pedido nuevo
OWNER_EMAIL=

# ---- Stripe (solo si cobras con tarjeta) ----
# Endpoint del webhook: https://TU-WEB/webhooks/stripe  (evento checkout.session.completed y .expired)
STRIPE_WEBHOOK_SECRET=

# ---- Produccion bajo demanda ----
# Por defecto la tienda NO controla unidades (no hay "agotado" ni "ultimas unidades").
# Pon TRACK_STOCK=1 solo si algun dia quieres limitar unidades por producto.
TRACK_STOCK=0
# Plazo de elaboracion que se muestra al cliente, por ejemplo: 5-7 dias laborables
LEAD_TIME=

# ---- Deteccion automatica de temas con IA (opcional) ----
# Con una clave de https://console.anthropic.com la tienda mira la imagen de cada producto
# y le asigna temas (montanas, retratos, animales...). Cuesta aprox. 0,01 EUR por imagen
# y solo se usa cuando TU guardas un producto o pulsas "Detectar temas".
# Sin clave se usan las palabras del titulo y la descripcion (gratis).
ANTHROPIC_API_KEY=
# Opcional: otro modelo (por ejemplo uno mas barato). Por defecto claude-opus-5-5
ANTHROPIC_MODEL=
