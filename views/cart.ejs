<%- include('partials/header') %>

<h1>Tu carrito</h1>

<% if (!cart.items.length) { %>
  <div class="empty-state">
    <h2>Tu carrito está vacío</h2>
    <p>Echa un vistazo al catálogo y encuentra algo que te guste.</p>
    <a class="btn" href="/">Ver la tienda</a>
  </div>
<% } else { %>
  <div class="layout-2">
    <section class="panel" aria-label="Artículos">
      <% cart.items.forEach((i) => { const max = shop.trackStock ? Math.min(i.stock, 10) : 10; %>
        <div class="cart-line">
          <a href="/producto/<%= i.id %>">
            <% if (i.image_path) { %><img src="<%= thumb(i.image_path, 200) %>" alt="<%= i.title %>" width="84" height="84" /><% } %>
          </a>
          <div>
            <h3><a href="/producto/<%= i.id %>"><%= i.title %></a></h3>
            <small><%= euro(i.price_cents) %> &middot; <%= TYPE_LABELS[i.type] || i.type %></small>
            <div class="controls">
              <form method="POST" action="/actualizar/<%= i.id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <label class="sr-only" for="qty-<%= i.id %>">Cantidad de <%= i.title %></label>
                <select id="qty-<%= i.id %>" name="quantity" data-autosubmit>
                  <% for (let n = 1; n <= max; n++) { %><option value="<%= n %>"<%= n === i.quantity ? ' selected' : '' %>><%= n %></option><% } %>
                </select>
                <noscript><button class="btn small secondary" type="submit">Actualizar</button></noscript>
              </form>
              <form method="POST" action="/quitar/<%= i.id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="btn small danger" type="submit">Quitar</button>
              </form>
            </div>
          </div>
          <div class="line-total"><%= euro(i.subtotal) %></div>
        </div>
      <% }) %>
    </section>

    <aside class="panel sticky" aria-label="Resumen">
      <h2>Resumen</h2>
      <% if (shop.freeFrom) { %>
        <% if (cart.freeShippingLeft > 0) { %>
          <small>Te faltan <b><%= euro(cart.freeShippingLeft) %></b> para el envío gratis</small>
          <div class="progress" role="presentation"><span style="width:<%= Math.min(100, Math.round(cart.subtotal / shop.freeFrom * 100)) %>%"></span></div>
        <% } else { %>
          <p class="flash success" style="margin:0 0 14px">Tienes envío gratis.</p>
        <% } %>
      <% } %>
      <div class="summary-row"><span>Subtotal</span><span><%= euro(cart.subtotal) %></span></div>
      <div class="summary-row"><span>Envío</span><span><%= cart.shipping ? euro(cart.shipping) : 'Gratis' %></span></div>
      <div class="summary-row total"><span>Total</span><span><%= euro(cart.total) %></span></div>
      <a class="btn block" style="margin-top:18px" href="/checkout">Continuar con el pedido</a>
      <p style="margin:14px 0 0;text-align:center"><a class="link" href="/">Seguir comprando</a></p>
    </aside>
  </div>
<% } %>

<%- include('partials/footer') %>
