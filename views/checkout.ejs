<% pageTitle = 'Pago' %>
<%- include('partials/header') %>

<h1>Datos de envio</h1>

<% if (!stripeConfigured) { %>
  <div class="alert info">
    El pago se hara por transferencia bancaria o Bizum. Tras confirmar el pedido veras los datos para pagar.
  </div>
<% } %>

<div class="row2" style="align-items:start;">
  <form class="stack" method="POST" action="/checkout/crear">
    <div>
      <label>Nombre completo</label>
      <input type="text" name="name" required />
    </div>
    <div>
      <label>Email</label>
      <input type="email" name="email" required />
    </div>
    <div>
      <label>Direccion</label>
      <input type="text" name="address" required />
    </div>
    <div class="row2">
      <div>
        <label>Ciudad</label>
        <input type="text" name="city" required />
      </div>
      <div>
        <label>Codigo postal</label>
        <input type="text" name="postal_code" required />
      </div>
    </div>
    <div>
      <label>Pais</label>
      <input type="text" name="country" value="ES" required />
    </div>
    <button class="btn block" type="submit">
      <%= stripeConfigured ? 'Continuar al pago con tarjeta' : 'Confirmar pedido' %>
    </button>
  </form>

  <div>
    <h3>Resumen</h3>
    <table class="simple">
      <% items.forEach(i => { %>
        <tr>
          <td><%= i.title %> x<%= i.quantity %></td>
          <td><%= ((i.price_cents * i.quantity) / 100).toFixed(2) %> &euro;</td>
        </tr>
      <% }) %>
      <tr>
        <td>Envio</td>
        <td><%= (shipping / 100).toFixed(2) %> &euro;</td>
      </tr>
    </table>
    <div class="totals">
      <span class="grand"><%= (total / 100).toFixed(2) %> &euro;</span>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
