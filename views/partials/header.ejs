<%
  const m = (typeof meta !== 'undefined' && meta) || {};
  const pageTitle = m.title ? m.title + ' · ' + artistName : artistName + ' · Tienda';
  const pageDesc = m.description || 'Dibujos, prints y stickers de 131.';
  const ogImg = m.image ? thumb(m.image, 1000) : '';
  const ogAbs = ogImg ? (/^https?:/.test(ogImg) ? ogImg : shop.siteUrl + ogImg) : '';
%><!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>" />
  <meta name="theme-color" content="#f6f3ee" />
  <script src="/js/theme-init.js"></script>
  <% if (m.noindex) { %><meta name="robots" content="noindex, nofollow" />
  <% } else { %><link rel="canonical" href="<%= shop.siteUrl + (m.canonicalPath || currentPath) %>" /><% } %>
  <meta property="og:locale" content="es_ES" />
  <% if (!m.noindex) { %><meta property="og:url" content="<%= shop.siteUrl + (m.canonicalPath || currentPath) %>" /><% } %>
  <meta property="og:site_name" content="<%= artistName %>" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= pageDesc %>" />
  <meta property="og:type" content="<%= m.type || 'website' %>" />
  <% if (ogAbs) { %><meta property="og:image" content="<%= ogAbs %>" />
  <meta name="twitter:card" content="summary_large_image" /><% } %>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/css/fonts.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
  <script src="/js/app.js?v=<%= assetVersion %>" defer></script>
</head>
<body>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <header class="site-header">
    <div class="wrap">
      <a href="/" class="logo" aria-label="<%= artistName %> - inicio"><%= artistName %><i>.</i></a>
      <nav class="nav" aria-label="Principal">
        <a href="/" <%- currentPath === '/' ? 'aria-current="page"' : '' %>>Tienda</a>
        <a href="/temas" <%- currentPath === '/temas' || currentPath.startsWith('/tema/') ? 'aria-current="page"' : '' %>>Temas</a>
        <% if (isAdmin) { %><a href="/admin" class="admin-pill">Panel</a><% } %>
        <a href="/carrito" class="cart-link" aria-label="Carrito, <%= cartCount %> artículos">
          Carrito
          <% if (cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %>
        </a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Cambiar entre tema claro y oscuro" title="Cambiar tema">
          <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </nav>
    </div>
  </header>
  <main id="contenido">
    <div class="wrap">
      <%- include('flash') %>
