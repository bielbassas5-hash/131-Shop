<%- include('../partials/header') %>

<div class="admin-top">
  <h1>Pedidos</h1>
  <div class="table-actions">
    <a class="btn secondary" href="/admin/pedidos.csv">Exportar CSV</a>
    <a class="btn ghost" href="/admin">Volver</a>
  </div>
</div>

<div class="chips" style="margin-bottom:20px">
  <a class="chip<%= !estado ? ' active' : '' %>" href="/admin/pedidos">Todos</a>
  <% ['pending', 'paid', 'shipped', 'cancelled'].forEach((s) => { %>
    <a class="chip<%= estado === s ? ' active' : '' %>" href="/admin/pedidos?estado=<%= s %>"><%= STATUS_LABELS[s] %> (<%= counts[s] || 0 %>)</a>
  <% }) %>
</div>

<% if (!orders.length) { %>
  <div class="empty-state"><p>No hay pedidos en esta vista.</p></div>
<% } else { %>
  <div class="table-wrap">
    <table class="simple">
      <thead><tr><th>#</th><th>Cliente</th><th>Total</th><th>Estado</th><th>Fecha</th><th></th></tr></thead>
      <tbody>
        <% orders.forEach((o) => { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><%= o.customer_name %><br /><small><%= o.customer_email %></small></td>
            <td><%= euro(o.total_cents) %></td>
            <td><span class="badge <%= o.status %>"><%= STATUS_LABELS[o.status] || o.status %></span></td>
            <td><small><%= o.created_at %></small></td>
            <td><a class="btn small secondary" href="/admin/pedidos/<%= o.id %>">Ver</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
