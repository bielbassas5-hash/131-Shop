<%- include('../partials/header') %>

<div class="admin-top">
  <h1>Panel</h1>
  <div class="table-actions">
    <a class="btn secondary" href="/admin/pedidos">Pedidos</a>
    <a class="btn secondary" href="/admin/temas">Temas</a>
    <a class="btn secondary" href="/admin/sobre-mi">Sobre mí</a>
    <a class="btn ghost" href="/admin/copia-seguridad.json" download>Copia de seguridad</a>
    <a class="btn" href="/admin/productos/nuevo">+ Nuevo producto</a>
    <form method="POST" action="/admin/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button class="btn ghost" type="submit">Salir</button>
    </form>
  </div>
</div>

<% if (weakPassword) { %>
  <div class="flash warn" role="alert"><div class="flash-body"><b>Cambia la contraseña de administrador.</b> La actual es corta o muy común. En Render: Environment &rarr; <code>ADMIN_PASSWORD</code> (usa 12 caracteres o más).</div></div>
<% } %>

<% const pending = checklist.filter((c) => !c.ok); %>
<% if (pending.length) { %>
  <section class="panel checklist" aria-label="Puesta en marcha">
    <h2>Puesta en marcha</h2>
    <p class="muted">Configura estas variables en Render (Environment) antes de vender de verdad.</p>
    <ul>
      <% checklist.forEach((c) => { %>
        <li class="<%= c.ok ? 'ok' : (c.optional ? 'opt' : 'todo-item') %>">
          <span aria-hidden="true"><%= c.ok ? '✓' : (c.optional ? '○' : '✗') %></span>
          <span><%= c.label %> <% if (!c.ok) { %><code><%= c.hint %></code><% } %></span>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<div class="stats">
  <div class="stat"><b><%= euro(stats.revenue) %></b><span>Ingresos confirmados</span></div>
  <a class="stat<%= stats.pending ? ' alert' : '' %>" href="/admin/pedidos?estado=pending"><b><%= stats.pending %></b><span>Pedidos pendientes de pago</span></a>
  <a class="stat<%= stats.toShip ? ' alert' : '' %>" href="/admin/pedidos?estado=paid"><b><%= stats.toShip %></b><span>Pagados, por elaborar y enviar</span></a>
  <% if (shop.trackStock) { %>
  <div class="stat"><b><%= stats.soldOut %></b><span>Productos agotados</span></div>
  <div class="stat"><b><%= stats.lowStock %></b><span>Con poco stock (&le; 2)</span></div>
  <% } %>
</div>

<h2>Productos</h2>
<% if (!products.length) { %>
  <div class="empty-state"><p>Todavía no hay productos.</p><a class="btn" href="/admin/productos/nuevo">Subir el primero</a></div>
<% } else { %>
  <div class="table-wrap">
    <table class="simple">
      <thead><tr><th></th><th>Título</th><th>Tipo</th><th>Precio</th><% if (shop.trackStock) { %><th>Stock</th><% } %><th>Estado</th><th></th></tr></thead>
      <tbody>
        <% products.forEach((p) => { %>
          <tr>
            <td><% if (p.image_path) { %><img class="thumb-sm" src="<%= thumb(p.image_path, 120) %>" alt="" width="52" height="52" /><% } %></td>
            <td><a class="link" href="/producto/<%= p.id %>"><%= p.title %></a></td>
            <td><%= TYPE_LABELS[p.type] || p.type %></td>
            <td><%= Number(p.variant_count) > 0 ? 'Desde ' : '' %><%= euro(p.price_cents) %></td>
            <% if (shop.trackStock) { %><td><%= p.stock %><% if (p.active && p.stock <= 0) { %> <span class="badge cancelled">Agotado</span><% } %></td><% } %>
            <td><span class="badge <%= p.active ? 'paid' : 'hidden' %>"><%= p.active ? 'Visible' : 'Oculto' %></span></td>
            <td>
              <div class="table-actions">
                <a class="btn small secondary" href="/admin/productos/<%= p.id %>/editar">Editar</a>
                <form method="POST" action="/admin/productos/<%= p.id %>/eliminar" data-confirm="Eliminar &quot;<%= p.title %>&quot;? Esta acción no se puede deshacer.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn small danger" type="submit">Eliminar</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
