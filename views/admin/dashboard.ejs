<% pageTitle = 'Panel admin' %>
<%- include('../partials/header') %>

<div class="admin-topbar">
  <h1>Productos</h1>
  <div class="admin-actions">
    <a class="btn secondary" href="/admin/pedidos">Ver pedidos</a>
    <a class="btn" href="/admin/productos/nuevo">+ Nuevo producto</a>
    <form method="POST" action="/admin/logout">
      <button class="btn secondary" type="submit">Salir</button>
    </form>
  </div>
</div>

<% if (products.length === 0) { %>
  <div class="empty-state"><p>No hay productos todavia.</p></div>
<% } else { %>
  <table class="simple">
    <thead>
      <tr>
        <th></th>
        <th>Titulo</th>
        <th>Tipo</th>
        <th>Precio</th>
        <th>Stock</th>
        <th>Estado</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(p => { %>
        <tr>
          <td><% if (p.image_path) { %><img class="thumb-sm" src="<%= p.image_path %>" alt="" /><% } %></td>
          <td><%= p.title %></td>
          <td><%= p.type %></td>
          <td><%= (p.price_cents / 100).toFixed(2) %> &euro;</td>
          <td><%= p.stock %></td>
          <td><%= p.active ? 'Activo' : 'Oculto' %></td>
          <td style="display:flex; gap:8px;">
            <a class="btn small secondary" href="/admin/productos/<%= p.id %>/editar">Editar</a>
            <form method="POST" action="/admin/productos/<%= p.id %>/eliminar" onsubmit="return confirm('Eliminar este producto?');">
              <button class="btn small danger" type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
