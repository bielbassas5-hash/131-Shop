<%- include('../partials/header') %>

<div class="admin-top">
  <h1>Pedido #<%= order.id %> <span class="badge <%= order.status %>"><%= STATUS_LABELS[order.status] || order.status %></span></h1>
  <a class="btn ghost" href="/admin/pedidos">Volver</a>
</div>

<div class="layout-2">
  <div>
    <section class="panel" style="margin-bottom:24px">
      <h2>Artículos</h2>
      <% items.forEach((i) => { %>
        <div class="mini-line"><span><%= i.title %> &times; <%= i.quantity %></span><span><%= euro(i.price_cents * i.quantity) %></span></div>
      <% }) %>
      <div class="summary-row"><span>Envío</span><span><%= euro(order.shipping_cents) %></span></div>
      <div class="summary-row total"><span>Total</span><span><%= euro(order.total_cents) %></span></div>
    </section>

    <section class="panel">
      <h2>Envío</h2>
      <dl class="kv">
        <dt>Nombre</dt><dd><%= shipTo.name || order.customer_name %></dd>
        <dt>Email</dt><dd><a class="link" href="mailto:<%= shipTo.email || order.customer_email %>"><%= shipTo.email || order.customer_email %></a></dd>
        <dt>Teléfono</dt><dd><%= shipTo.phone || '-' %></dd>
        <dt>Entrega</dt><dd><%= order.shipping_method === 'pickup' ? 'Recogida en mano' : 'Envío a domicilio' %></dd>
        <% if (order.shipping_method !== 'pickup') { %>
        <dt>Dirección</dt><dd><%= shipTo.address %></dd>
        <dt>Ciudad</dt><dd><%= shipTo.postal_code %> <%= shipTo.city %></dd>
        <dt>País</dt><dd><%= shipTo.country %></dd>
        <% } %>
        <% if (shipTo.notes) { %><dt>Notas</dt><dd style="white-space:pre-line"><%= shipTo.notes %></dd><% } %>
        <dt>Recibido</dt><dd><%= dateTime(order.created_at) %></dd>
      </dl>
    </section>
  </div>

  <aside class="panel">
    <h2>Gestionar</h2>
    <form method="POST" action="/admin/pedidos/<%= order.id %>/estado">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field">
        <label for="status">Estado</label>
        <select id="status" name="status">
          <% statuses.forEach((s) => { %><option value="<%= s %>"<%= order.status === s ? ' selected' : '' %>><%= STATUS_LABELS[s] %></option><% }) %>
        </select>
        <% if (shop.trackStock) { %><p class="field-hint">Al cancelar, las unidades vuelven al stock.</p><% } %>
      </div>
      <div class="field">
        <label for="tracking">Número de seguimiento</label>
        <input id="tracking" type="text" name="tracking" value="<%= order.tracking_number || '' %>" maxlength="40" />
      </div>
      <% if (mailConfigured) { %>
      <div class="field">
        <label class="check" for="notify"><input id="notify" type="checkbox" name="notify" value="1" checked /><span>Avisar al cliente por email (al marcar pagado o enviado)</span></label>
      </div>
      <% } %>
      <button class="btn block" type="submit">Guardar</button>
    </form>
    <hr />
    <a class="btn secondary block" href="<%= mailto %>">Avisar al cliente por email</a>
    <p class="field-hint">Abre tu correo con el mensaje y el enlace de seguimiento ya preparados.</p>
    <p class="field-hint">Enlace del cliente: <a class="link" href="<%= publicLink %>" target="_blank" rel="noopener">ver pedido</a></p>
  </aside>
</div>

<%- include('../partials/footer') %>
