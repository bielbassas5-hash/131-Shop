<%- include('../partials/header') %>
<%
  const f = form || (product ? {
    title: product.title,
    description: product.description || '',
    price: (product.price_cents / 100).toFixed(2),
    stock: String(product.stock),
    type: product.type,
    active: !!product.active
  } : { title: '', description: '', price: '', stock: '1', type: 'sticker', active: true });
  const e = errors || {};
  const err = (k) => e[k] ? '<p class="field-error">' + e[k] + '</p>' : '';
  const action = product ? '/admin/productos/' + product.id + '/editar' : '/admin/productos/nuevo';
%>

<div class="admin-top">
  <h1><%= product ? 'Editar producto' : 'Nuevo producto' %></h1>
  <a class="btn ghost" href="/admin">Volver</a>
</div>

<% if (error) { %><div class="flash error" role="alert"><div class="flash-body"><%= error %></div></div><% } %>

<form class="panel form-card" method="POST" action="<%= action %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data" data-once>
  <div class="field">
    <label for="title">Título</label>
    <input id="title" type="text" name="title" value="<%= f.title %>" maxlength="80" required />
    <%- err('title') %>
  </div>
  <div class="field">
    <label for="description">Descripción</label>
    <textarea id="description" name="description" maxlength="1500"><%= f.description %></textarea>
    <p class="field-hint">Cuenta la historia de la pieza, medidas, materiales, técnica...</p>
  </div>
  <div class="row2">
    <div class="field">
      <label for="price">Precio (EUR)</label>
      <input id="price" type="text" inputmode="decimal" name="price" value="<%= f.price %>" placeholder="4,50" />
      <%- err('price') %>
    </div>
    <div class="field">
      <% if (shop.trackStock) { %>
      <label for="stock">Unidades disponibles</label>
      <input id="stock" type="number" min="0" max="9999" name="stock" value="<%= f.stock %>" required />
      <%- err('stock') %>
      <% } %>
    </div>
  </div>
  <fieldset class="field method-box formats-box" data-formats<%= product ? '' : ' data-autocheck' %>>
    <legend>Formatos y precios (opcional)</legend>
    <p class="field-hint" data-dims-hint><%= dims ? 'Resolución de la imagen: ' + dims.width + ' × ' + dims.height + ' px.' : 'Al elegir la imagen verás qué formatos permite con buena calidad.' %></p>
    <div class="format-rows">
      <% formatRows.forEach((r) => { %>
        <div class="format-row" data-short-mm="<%= Math.min(...r.mm) %>" data-long-mm="<%= Math.max(...r.mm) %>">
          <label class="check"><input type="checkbox" name="fmt" value="<%= r.id %>"<%= r.checked ? ' checked' : '' %> /><span><b><%= r.label %></b></span></label>
          <input type="text" inputmode="decimal" name="fmt_price_<%= r.id %>" value="<%= r.price %>" placeholder="Precio €" aria-label="Precio del formato <%= r.id %>" />
          <span class="quality<%= r.level ? ' q-' + r.level : '' %>" data-quality><%= r.level ? r.levelLabel + ' (' + r.ppp + ' ppp)' : '' %></span>
        </div>
      <% }) %>
    </div>
    <div class="row2">
      <div>
        <label for="source_width">Ancho del archivo original (px)</label>
        <input id="source_width" type="number" name="source_width" min="1" max="30000" value="<%= dims ? dims.width : '' %>" />
      </div>
      <div>
        <label for="source_height">Alto del archivo original (px)</label>
        <input id="source_height" type="number" name="source_height" min="1" max="30000" value="<%= dims ? dims.height : '' %>" />
      </div>
    </div>
    <p class="field-hint">Se rellena solo al elegir la imagen. Corrígelo si subes una versión reducida y guardas el archivo grande aparte. La tienda guarda una versión web de la imagen: para imprimir se usa tu archivo original. Calidad: óptima desde 300 ppp, aceptable desde 200 ppp.</p>
    <div>
      <label for="variants_text">Otros formatos (una línea cada uno)</label>
      <textarea id="variants_text" name="variants_text" class="short" maxlength="700" placeholder="Marco 30x40: 35,00"><%= variantsText %></textarea>
      <p class="field-hint">Para tamaños que no son A5-A1. Si activas algún formato, el cliente elige uno y el precio base pasa a ser el más barato (no hace falta el campo "Precio"). Máximo <%= maxVariants %> en total.</p>
    </div>
    <%- err('variants') %>
  </fieldset>
  <div class="field">
    <label for="type">Tipo</label>
    <select id="type" name="type">
      <% Object.keys(TYPE_LABELS).forEach((t) => { %><option value="<%= t %>"<%= f.type === t ? ' selected' : '' %>><%= TYPE_LABELS[t] %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="image">Imagen <%= product ? '(deja vacío para mantener la actual)' : '' %></label>
    <% if (product && product.image_path) { %><img class="preview" src="<%= thumb(product.image_path, 300) %>" alt="Imagen actual" /><% } %>
    <img id="image-preview" class="preview" alt="Vista previa" hidden />
    <input id="image" type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" data-preview <%= product ? '' : 'required' %> />
    <p class="field-hint">PNG, JPG, WEBP o GIF. Máximo 8 MB. Mejor cuadrada (por ejemplo 1500 x 1500 px).</p>
  </div>
  <div class="field">
    <label for="extra">Imágenes adicionales (opcional, hasta <%= maxExtras %>)</label>
    <% if (extras.length) { %>
      <div class="thumb-row">
        <% extras.forEach((e) => { %>
          <label class="thumb-remove">
            <img src="<%= thumb(e.image_path, 200) %>" alt="Imagen adicional" width="90" height="90" />
            <span class="check"><input type="checkbox" name="remove_extra" value="<%= e.id %>" /> Quitar</span>
          </label>
        <% }) %>
      </div>
    <% } %>
    <input id="extra" type="file" name="extra" multiple accept="image/png,image/jpeg,image/webp,image/gif" />
    <p class="field-hint">Detalles, escala, reverso... Se muestran como galería en la ficha del producto.</p>
  </div>
  <fieldset class="field method-box themes-box">
    <legend>Temas</legend>
    <% if (allThemes.length) { %>
      <div class="theme-checks">
        <% allThemes.forEach((t) => { %>
          <label class="check"><input type="checkbox" name="themes" value="<%= t.id %>"<%= selectedThemeIds.includes(Number(t.id)) ? ' checked' : '' %> /><span><%= t.name %></span></label>
        <% }) %>
      </div>
    <% } %>
    <div>
      <label for="new_themes">Otros temas (separados por comas)</label>
      <input id="new_themes" type="text" name="new_themes" value="<%= f.newThemes || '' %>" maxlength="200" placeholder="Acuarela, Cuadros" />
    </div>
    <label class="check" for="auto_themes">
      <input id="auto_themes" type="checkbox" name="auto_themes" value="1"<%= (f.autoThemes !== undefined ? f.autoThemes : !product) ? ' checked' : '' %> />
      <span>Si no elijo ninguno, detectar el tema automáticamente <%= aiEnabled ? '(con IA, a partir de la imagen)' : '(por palabras del título y la descripción)' %></span>
    </label>
  </fieldset>
  <% if (product) { %>
    <div class="field">
      <label class="check" for="active"><input id="active" type="checkbox" name="active" value="1"<%= f.active ? ' checked' : '' %> /><span>Visible en la tienda</span></label>
    </div>
  <% } %>
  <button class="btn block" type="submit"><%= product ? 'Guardar cambios' : 'Publicar producto' %></button>
</form>

<% if (product) { %>
  <form class="panel form-card mt20" method="POST" action="/admin/productos/<%= product.id %>/detectar-temas">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <h3>Detectar temas ahora</h3>
    <p class="field-hint">Analiza <%= aiEnabled ? 'la imagen con IA' : 'el título y la descripción' %> y <b>añade</b> los temas que encuentre, sin quitar los que ya tiene.</p>
    <button class="btn secondary" type="submit">Detectar y añadir temas</button>
  </form>
<% } %>

<%- include('../partials/footer') %>
