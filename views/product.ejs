<%- include('partials/header') %>
<%
  const soldOut = shop.trackStock && product.stock <= 0;
  const jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.title,
    description: product.description || product.title,
    image: gallery.map((g) => (/^https?:/.test(g) ? g : shop.siteUrl + g)),
    sku: sku,
    brand: { '@type': 'Brand', name: artistName },
    offers: variants.length > 1 ? {
      '@type': 'AggregateOffer',
      priceCurrency: 'EUR',
      lowPrice: (Math.min(...variants.map((v) => v.price_cents)) / 100).toFixed(2),
      highPrice: (Math.max(...variants.map((v) => v.price_cents)) / 100).toFixed(2),
      offerCount: variants.length,
      availability: soldOut ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
      url: shop.siteUrl + productUrl(product)
    } : {
      '@type': 'Offer',
      priceCurrency: 'EUR',
      price: (product.price_cents / 100).toFixed(2),
      availability: soldOut ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
      url: shop.siteUrl + productUrl(product)
    }
  }).replace(/</g, '\\u003c');
%>
<script type="application/ld+json"><%- jsonLd %></script>

<nav class="crumbs" aria-label="Migas de pan">
  <a href="/">Tienda</a> / <a href="/?tipo=<%= product.type %>"><%= TYPE_PLURALS[product.type] || product.type %></a> / <span><%= product.title %></span>
</nav>

<div class="product-detail">
  <div class="product-media">
    <div class="product-gallery">
      <% if (product.image_path) { %>
        <button type="button" class="zoom" data-lightbox data-full="<%= thumb(product.image_path, 2000) %>" aria-label="Ampliar imagen">
          <img id="main-image" src="<%= thumb(product.image_path, 1100) %>" alt="<%= product.title %>" width="1100" height="1100" fetchpriority="high" decoding="async" />
        </button>
      <% } %>
    </div>
    <% if (gallery.length > 1) { %>
      <ul class="gallery-thumbs" aria-label="Más imágenes">
        <% gallery.forEach((src, idx) => { %>
          <li>
            <a href="<%= thumb(src, 1100) %>" data-gallery-src="<%= thumb(src, 1100) %>" data-gallery-full="<%= thumb(src, 2000) %>" class="<%= idx === 0 ? 'active' : '' %>" aria-label="Ver imagen <%= idx + 1 %>">
              <img src="<%= thumb(src, 160) %>" alt="" width="80" height="80" loading="lazy" />
            </a>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <div class="product-info">
    <span class="tag"><%= TYPE_LABELS[product.type] || product.type %></span>
    <h1><%= product.title %></h1>
    <% if (productThemes.length) { %>
      <ul class="tag-list" aria-label="Temas">
        <% productThemes.forEach((t) => { %><li><a href="/tema/<%= t.slug %>"><%= t.name %></a></li><% }) %>
      </ul>
    <% } %>
    <span class="price" id="product-price"><%= euro(variants.length ? variants[0].price_cents : product.price_cents) %></span>
    <% if (product.description) { %><p class="desc"><%= product.description %></p><% } %>
    <% if (details.length) { %>
      <dl class="specs" aria-label="Ficha técnica">
        <% details.forEach((d) => { %><div><dt><%= d.label %></dt><dd><%= d.value %></dd></div><% }) %>
      </dl>
    <% } %>

    <div class="buy-box">
      <% if (!soldOut) { %>
        <form method="POST" action="/agregar/<%= product.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="back" value="<%= productUrl(product) %>" />
          <% if (variants.length) { %>
            <fieldset class="variants">
              <legend>Formato</legend>
              <% variants.forEach((v, idx) => { %>
                <label class="variant-opt">
                  <input type="radio" name="variant" value="<%= v.id %>" data-price-label="<%= euro(v.price_cents) %>"<%= idx === 0 ? ' checked' : '' %> required />
                  <span><%= v.label %> <small><%= euro(v.price_cents) %></small></span>
                </label>
              <% }) %>
            </fieldset>
          <% } %>
          <button class="btn block" type="submit">Añadir al carrito</button>
        </form>
        <% if (shop.trackStock && product.stock <= 3) { %><p class="stock-note">Solo quedan <%= product.stock %> unidades.</p><% } %>
      <% } else { %>
        <button class="btn block" type="button" disabled>Agotado</button>
        <p class="stock-note">Esta pieza ya no está disponible.</p>
      <% } %>
      <ul>
        <li>Envío <%= shop.freeFrom ? 'desde ' + euro(shop.shippingCents) + ', gratis a partir de ' + euro(shop.freeFrom) : 'a ' + euro(shop.shippingCents) + ' por pedido' %></li>
        <% if (!shop.trackStock) { %><li>Se elabora bajo pedido<%= shop.leadTime ? ' · plazo de ' + shop.leadTime : '' %></li><% } %>
        <li><a class="link" href="/legal/condiciones">Devoluciones en 14 días</a></li>
      </ul>
    </div>
    <div class="share" aria-label="Compartir">
      <span class="share-ref">Ref. <%= sku %></span>
      <span class="share-links">
        <button type="button" class="link-btn" data-copy="<%= shop.siteUrl + productUrl(product) %>">Copiar enlace</button>
        <a class="link-btn" href="https://wa.me/?text=<%= encodeURIComponent(product.title + ' ' + shop.siteUrl + productUrl(product)) %>" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a class="link-btn" href="mailto:?subject=<%= encodeURIComponent(product.title) %>&amp;body=<%= encodeURIComponent(shop.siteUrl + productUrl(product)) %>">Email</a>
      </span>
    </div>
  </div>
</div>

<% if (related.length) { %>
  <div class="section-title"><h2>Más productos</h2></div>
  <div class="grid">
    <% related.forEach((p) => { %><%- include('partials/product-card', { p }) %><% }) %>
  </div>
<% } %>

<dialog class="lightbox" id="lightbox" aria-label="Imagen ampliada">
  <button type="button" class="lb-close" aria-label="Cerrar" data-lb-close>&times;</button>
  <div class="lb-body"><img alt="" /></div>
</dialog>

<%- include('partials/footer') %>
