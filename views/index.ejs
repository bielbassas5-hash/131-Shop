<%- include('partials/header') %>
<%
  const link = (o) => {
    const merged = Object.assign({}, filters, o);
    const params = new URLSearchParams();
    ['tipo', 'orden', 'q'].forEach((k) => { if (merged[k] && !(k === 'orden' && merged[k] === 'nuevo')) params.set(k, merged[k]); });
    const s = params.toString();
    return (merged.tema ? '/tema/' + merged.tema : '/') + (s ? '?' + s : '');
  };
  const filtered = filters.tipo || filters.q || filters.tema;
%>

<section aria-labelledby="catalogo-titulo">
  <% if (featured) { %>
    <h1 id="catalogo-titulo" class="sr-only">Tienda</h1>
  <% } else { %>
    <div class="page-head">
      <h1 id="catalogo-titulo"><%= theme ? theme.name : (filters.tipo ? TYPE_PLURALS[filters.tipo] : 'Tienda') %></h1>
    </div>
  <% } %>
  <div class="info-strip">
    <span>Envío <%= euro(shop.shippingCents) %><% if (shop.freeFrom) { %>, gratis desde <%= euro(shop.freeFrom) %><% } %></span>
    <% if (!shop.trackStock) { %><span>Se elabora bajo pedido<%= shop.leadTime ? ' · plazo de ' + shop.leadTime : '' %></span><% } %>
    <% if (shop.pickupEnabled) { %><span>Recogida en mano disponible</span><% } %>
  </div>

  <% if (featured) { %>
    <section class="feature" aria-label="Última obra añadida">
      <a class="feature-media" href="<%= productUrl(featured) %>" tabindex="-1" aria-hidden="true">
        <img src="<%= thumb(featured.image_path, 1100) %>" alt="" width="1100" height="1100" fetchpriority="high" decoding="async" />
      </a>
      <div class="feature-body">
        <span class="eyebrow">Última obra añadida · <%= TYPE_LABELS[featured.type] || featured.type %></span>
        <h2><a href="<%= productUrl(featured) %>"><%= featured.title %></a></h2>
        <% if (featured.description) { %><p class="desc"><%= featured.description.replace(/\s+/g, ' ').slice(0, 200) %><%= featured.description.length > 200 ? '…' : '' %></p><% } %>
        <span class="price"><%= featured.variant_count > 0 ? 'Desde ' : '' %><%= euro(featured.price_cents) %></span>
        <a class="btn" href="<%= productUrl(featured) %>">Ver</a>
      </div>
    </section>
  <% } %>

  <div class="toolbar">
    <div class="chips tabs" role="group" aria-label="Filtrar por tipo">
      <a class="chip<%= !filters.tipo ? ' active' : '' %>" href="<%= link({ tipo: '' }) %>">Todo</a>
      <% ['dibujo', 'print', 'sticker'].forEach((t) => { %>
        <a class="chip<%= filters.tipo === t ? ' active' : '' %>" href="<%= link({ tipo: t }) %>"><%= TYPE_PLURALS[t] %></a>
      <% }) %>
    </div>
    <form class="filters" method="GET" action="<%= filters.tema ? '/tema/' + filters.tema : '/' %>" role="search">
      <% if (filters.tipo) { %><input type="hidden" name="tipo" value="<%= filters.tipo %>" /><% } %>
      <label class="sr-only" for="q">Buscar</label>
      <input id="q" type="search" name="q" value="<%= filters.q %>" placeholder="Buscar" maxlength="40" />
      <label class="sr-only" for="orden">Ordenar</label>
      <select id="orden" name="orden" data-autosubmit>
        <option value="nuevo"<%= filters.orden === 'nuevo' ? ' selected' : '' %>>Más recientes</option>
        <option value="precio_asc"<%= filters.orden === 'precio_asc' ? ' selected' : '' %>>Precio: menor a mayor</option>
        <option value="precio_desc"<%= filters.orden === 'precio_desc' ? ' selected' : '' %>>Precio: mayor a menor</option>
      </select>
      <button class="btn secondary small" type="submit">Buscar</button>
    </form>
  </div>

  <% if (themes.length) { %>
    <nav class="chips themes" aria-label="Temas">
      <span class="chips-label">Temas</span>
      <a class="chip<%= !filters.tema ? ' active' : '' %>" href="<%= link({ tema: '' }) %>">Todos</a>
      <% themes.forEach((t) => { %>
        <a class="chip<%= filters.tema === t.slug ? ' active' : '' %>" href="<%= link({ tema: t.slug }) %>"><%= t.name %> <span class="count"><%= t.active_count %></span></a>
      <% }) %>
      <a class="chip ghost-link" href="/temas">Ver agrupados</a>
    </nav>
  <% } %>

  <% if (total === 0) { %>
    <div class="empty-state">
      <% if (filtered) { %>
        <p>No hay resultados con esos filtros.</p>
        <a class="btn secondary" href="/">Quitar filtros</a>
      <% } else { %>
        <p>No hay productos disponibles ahora mismo.</p>
      <% } %>
    </div>
  <% } else { %>
    <% if (featured) { %>
      <div class="catalog-head"><h2>Todas las obras</h2><span class="muted"><%= total %> en total</span></div>
    <% } %>
    <div class="grid">
      <% products.forEach((p) => { %><%- include('partials/product-card', { p }) %><% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
